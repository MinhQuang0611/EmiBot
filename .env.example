# Copy to .env and fill in. .env holds secrets: never commit or share it.
# Variables already set in the shell win over this file.

# --- Optional: test on a personal Outlook.com mailbox (not production) ---
# EMI_AUTH=device
# EMI_TOKEN_CACHE=.emi-token.json
# EMI_TEST_SENDER=

# --- Outlook (Microsoft Graph) for sales@haya-hotels.com ---
# Two ways in:
#  a) EMI_AUTH=delegated (same as Sunny): tenant + client ID only, no secret. Sign in ONCE as
#     sales@ with a device code (`python -m tools.acceptance mail-read` in a terminal); the refresh
#     token is cached in EMI_TOKEN_CACHE. The app needs "Allow public client flows" and delegated Mail.ReadWrite.
#  b) No EMI_AUTH: app-only with EMI_CLIENT_SECRET, Mail.Read + Mail.ReadWrite application permissions,
#     limited to sales@ by an Exchange application access policy.
# EMI_AUTH=delegated
# EMI_TOKEN_CACHE=/data/emi/.emi-token.json
EMI_TENANT_ID=
EMI_CLIENT_ID=
EMI_CLIENT_SECRET=
EMI_MAILBOX=sales@haya-hotels.com

# --- Google Sheets / Drive ---
# Path to the service-account JSON key. Keep the key outside this folder.
EMI_GOOGLE_KEYFILE=
# Live intake sheet: 16pFhmPB6sQB7Bu8S61qq094cvq8Ie1OcRGCeC-CR440, tab Intake
EMI_SHEET_ID=16pFhmPB6sQB7Bu8S61qq094cvq8Ie1OcRGCeC-CR440
EMI_SHEET_TAB=Intake

# --- Run state ---
EMI_STATE_PATH=emi-state.json

# --- AI model for agent emi (deploy/set-model.sh) ---
# anthropic | openai
EMI_LLM_PROVIDER=anthropic
# Empty = default for the provider (anthropic/claude-sonnet-5-5, openai/gpt-5.6-sol).
# If set, must start with the provider name, e.g. anthropic/claude-opus-5-5
EMI_LLM_MODEL=
# Key for the chosen provider. On the VPS these go in /docker/openclaw-lk3h/.env (OpenClaw container env).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
